{
  "expo": {
    "name": "ZindagiCare",
    "slug": "zindagicare-mobile",
    "scheme": "zindagicare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zindagicare.mobile"
    },
    "android": {
      "package": "com.zindagicare.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0FA79B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.ico"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "ZindagiCare needs access to your photos so you can attach a profile photo, payment receipt, or verification document.",
          "cameraPermission": "ZindagiCare needs access to your camera so you can take a photo for your profile or a document you're uploading."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ZindagiCare needs your location to find nearby staff and route them to you when you request a home visit."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ZindagiCare needs access to your microphone so you can send voice notes in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0FA79B"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "16b2add5-867a-4798-89e2-95915873b43e"
      }
    },
    "owner": "ibrahim1065"
  }
}
