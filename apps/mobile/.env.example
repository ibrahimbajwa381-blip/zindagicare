# Copy to .env.local. Point this at your apps/web dev server's LAN IP
# (not "localhost" — a physical device/emulator can't reach your machine's localhost).
EXPO_PUBLIC_API_URL=http://192.168.1.5:3000

# Google sign-in — see root .env.example for how to create these in Google Cloud Console.
# WEB client id also covers Expo Go's proxy-based OAuth flow during development.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
