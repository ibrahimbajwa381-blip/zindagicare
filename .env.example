# App — place this file as BOTH:
#   .env.local (repo root, optional)
#   apps/web/.env.local (required for Next.js dev server)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://zindagicare.com — must match live domain for SEO canonicals & sitemap
# Google Search Console verification token (optional — paste the content value only)
GOOGLE_SITE_VERIFICATION=
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 prefers AUTH_SECRET (use the same value for both)
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Comma-separated emails that automatically receive the admin role on sign-in.
# Example: ADMIN_ALLOWLIST_EMAILS=dr.usama@example.com,ops@zindagicare.pk
ADMIN_ALLOWLIST_EMAILS=

# AES-256-GCM field-level encryption for PII at rest (32-byte key, base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/zindagicare
# Set only on machines with broken mongodb+srv DNS (e.g. some Windows setups). Do NOT set on Vercel.
# MONGODB_FORCE_IPV4=true

# OAuth — Google sign-in / sign-up
# 1. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# 2. Application type: Web application
# 3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    (production: https://your-domain.com/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone OTP (SMS gateway — optional in dev; OTP logged to console)
SMS_API_KEY=

# Supabase Storage — all user uploads (avatars, verification docs, reports)
# Free tier: 1 GB storage. Create a private bucket named to match SUPABASE_STORAGE_BUCKET.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=zindagicare

# Redis (rate limits, slot holds)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payments — MVP uses dummy test payments by default (no gateway credentials needed).
# Set PAYMENTS_LIVE=true (or JAZZCASH_LIVE=true) + credentials below for real checkout.
PAYMENTS_LIVE=false
JAZZCASH_LIVE=false
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Zoom video consultations — requires TWO Zoom Marketplace apps
#
# APP 1 — Server-to-Server OAuth ("ZindagiCare Backend")
#   Used by the backend to create scheduled meetings via REST API.
#   Scopes: meeting:write:meeting:admin, meeting:read:meeting:admin, user:read:user:admin
#   Activate the app on your Zoom account.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom user who owns created meetings (email or user id). "me" works for many accounts.
ZOOM_HOST_USER_ID=me
#
# APP 2 — General app with Meeting SDK enabled (NOT Server-to-Server OAuth)
#   Used to sign embedded join tokens. Activate the app, enable Features → Embed → Meeting SDK,
#   and add domain allowlist entries for every origin that loads /consult/video:
#     Development:  localhost
#     Production:   your-domain.com  (no https:// prefix)
#   Credentials come from the General app's Basic Information page.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
NEXT_PUBLIC_ZOOM_SDK_KEY=
# Only set when ONE General app provides both Meeting SDK JWT and REST API (unusual).
# ZOOM_SDK_USE_CLIENT_ID=true

# Maps & notifications
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
FCM_SERVER_KEY=
# Web Push (PWA) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@zindagicare.pk
SMS_API_KEY=

# AI Health Assistant (Google Gemini — free tier via AI Studio)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
COPILOT_ENABLED=true
COPILOT_RATE_LIMIT=30
