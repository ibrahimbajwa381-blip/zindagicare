# App — place this file as BOTH:
#   .env.local (repo root, optional)
#   apps/web/.env.local (required for Next.js dev server)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 prefers AUTH_SECRET (use the same value for both)
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# AES-256-GCM field-level encryption for PII at rest (32-byte key, base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/zindagicare
# Set only on machines with broken mongodb+srv DNS (e.g. some Windows setups). Do NOT set on Vercel.
# MONGODB_FORCE_IPV4=true

# OAuth — Google sign-in / sign-up
# 1. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# 2. Application type: Web application
# 3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    (production: https://your-domain.com/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone OTP (SMS gateway — optional in dev; OTP logged to console)
SMS_API_KEY=

# Supabase Storage — all user uploads (avatars, verification docs, reports)
# Free tier: 1 GB storage. Create a private bucket named to match SUPABASE_STORAGE_BUCKET.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=zindagicare

# Redis (rate limits, slot holds)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payments — MVP uses dummy test payments by default (no JazzCash credentials needed).
# Set JAZZCASH_LIVE=true + credentials below when ready for real gateway.
JAZZCASH_LIVE=false
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Zoom video consultations (Server-to-Server OAuth + Meeting SDK)
# Create apps in Zoom Marketplace: Server-to-Server OAuth (meetings API) + Meeting SDK (embedded join).
# After changing domains, add your production hostname to the SDK app Allowlist (e.g. app.zindagicare.com).
# Set NEXTAUTH_URL and NEXT_PUBLIC_APP_URL to the same public origin.
# General App credentials: set ZOOM_SDK_USE_CLIENT_ID=true and use Client ID as NEXT_PUBLIC_ZOOM_SDK_KEY.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=me
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_SDK_USE_CLIENT_ID=
NEXT_PUBLIC_ZOOM_SDK_KEY=

# Maps & notifications
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
FCM_SERVER_KEY=
SMS_API_KEY=
