# App — place this file as BOTH:
#   .env.local (repo root, optional)
#   apps/web/.env.local (required for Next.js dev server)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 prefers AUTH_SECRET (use the same value for both)
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# AES-256-GCM field-level encryption for PII at rest (32-byte key, base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/zindagicare
# Set only on machines with broken mongodb+srv DNS (e.g. some Windows setups). Do NOT set on Vercel.
# MONGODB_FORCE_IPV4=true

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone OTP (SMS gateway — optional in dev; OTP logged to console)
SMS_API_KEY=

# Supabase (file uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (rate limits, slot holds)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payments — MVP uses dummy test payments by default (no JazzCash credentials needed).
# Set JAZZCASH_LIVE=true + credentials below when ready for real gateway.
JAZZCASH_LIVE=false
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Zoom video consultations (Server-to-Server OAuth + Meeting SDK)
# Create a Server-to-Server OAuth app and Meeting SDK app in Zoom Marketplace.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=me
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
NEXT_PUBLIC_ZOOM_SDK_KEY=

# Maps & notifications
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
FCM_SERVER_KEY=
SMS_API_KEY=
